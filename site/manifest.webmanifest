{
  "id": "./",
  "name": "AMAD: Daily Learning for Business Growth",
  "short_name": "AMAD",
  "description": "A personalised daily learning and knowledge discovery platform for business growth, strategy, leadership and professional development.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa#/today",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#EEF0F5",
  "theme_color": "#EEF0F5",
  "categories": [
    "education",
    "business",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
